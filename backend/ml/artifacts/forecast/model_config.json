{
    "feature_columns": [
        "energy_kwh",
        "hour_sin",
        "hour_cos",
        "dow_sin",
        "dow_cos",
        "month_sin",
        "month_cos",
        "lag_1",
        "lag_2",
        "lag_4",
        "lag_48",
        "rolling_mean_2",
        "rolling_mean_4",
        "rolling_mean_48",
        "rolling_max_48"
    ],
    "target_column": "energy_kwh",
    "lookback": 48,
    "horizon": 48,
    "sampling_interval_minutes": 30,
    "forecast_hours": 24,
    "scaler": "StandardScaler",
    "model": "Horizon-Specific Multi-Scale Transformer",
    "patch_sizes": [
        4,
        8,
        16
    ],
    "d_model": 128,
    "n_heads": 4,
    "num_layers": 3,
    "ffn_dim": 512,
    "dropout": 0.1,
    "activation": "GELU",
    "fusion": "simple_mean",
    "loss": "HuberLoss",
    "optimizer": "AdamW",
    "learning_rate": 0.0003,
    "weight_decay": 0.0001
}