# ============================================================
# AI Energy Consumption Prediction & Optimization
# Frontend Environment Configuration
# ============================================================

# API Base URL (proxied through Vite dev server to backend on :5000)
VITE_API_URL=/api

# Set to 'false' to use real backend API; 'true' (or absent) uses Mock Mode
# Mock Mode allows full UI demonstration without a running database
VITE_USE_MOCK_API=true
